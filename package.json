    "claude-code",
    "gemini-cli",
    "coding-agent",
    "ai-agents",
    "tokens",
    "hooks",
    "verification",
    "benchmark",
    "evaluation",
    "cli",
    "privacy"
  ],
  "license": "Apache-2.0",
  "author": "apex-context-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apex-context-dev/apex-context.git"
  },
  "homepage": "https://github.com/apex-context-dev/apex-context#readme",
  "bugs": {
    "url": "https://github.com/apex-context-dev/apex-context/issues"
  },
  "type": "module",
  "bin": {
    "apex-context": "bin/apex-context.mjs"
  },
  "files": [
